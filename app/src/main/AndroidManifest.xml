<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Craftify"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Craftify"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity android:name=".LogoActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".HomeActivity" />
        <activity android:name=".ProductDetailActivity"/>
        <activity android:name=".SearchActivity" />
        <activity android:name=".CartActivity" />
        <activity android:name=".OrderConfirmationActivity" />
        <activity android:name=".PaymentActivity" />
        <activity android:name=".AddressActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".WishListActivity" />
        <activity android:name=".ProfileActivity" />
        <activity android:name=".OrderTrackingActivity"/>
        <activity android:name=".OrderSplashActivity"/>
        <activity android:name=".CategoriesActivity" />
        <activity android:name=".VisualizationActivity" />
        <activity android:name=".TrackProgressActivity"/>
        <activity android:name=".FeedbackActivity" />
        <activity android:name=".ContactActivity"/>
    </application>

</manifest>