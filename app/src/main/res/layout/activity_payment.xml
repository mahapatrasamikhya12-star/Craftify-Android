<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F4">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@color/primary"
        android:gravity="bottom|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Step Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="✓ Cart" android:textColor="#AAAAAA" android:textSize="12sp"/>
        <View android:layout_width="32dp" android:layout_height="2dp"
            android:background="@color/primary"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="✓ Address" android:textColor="#AAAAAA" android:textSize="12sp"/>
        <View android:layout_width="32dp" android:layout_height="2dp"
            android:background="@color/primary"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="③ Payment" android:textColor="@color/primary"
            android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Total Amount -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:background="#E8F0FE"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Total Amount"
                    android:textColor="#1a73e8" android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tvPaymentTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textColor="#1a73e8"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Delivering To -->
            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Delivering to" android:textColor="#888888"
                        android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:id="@+id/tvPaymentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Name"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvPaymentAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Payment Method -->
            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Select Payment Method"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <RadioGroup
                        android:id="@+id/radioPayment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioUPI"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="📱  UPI / PhonePe / GPay"
                            android:textSize="13sp"
                            android:textColor="#222222"
                            android:buttonTint="@color/primary"
                            android:paddingStart="12dp"
                            android:layout_marginBottom="8dp"/>

                        <RadioButton
                            android:id="@+id/radioCard"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="💳  Credit / Debit Card"
                            android:textSize="13sp"
                            android:textColor="#222222"
                            android:buttonTint="@color/primary"
                            android:paddingStart="12dp"
                            android:layout_marginBottom="8dp"/>

                        <RadioButton
                            android:id="@+id/radioCOD"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="🏠  Cash on Delivery"
                            android:textSize="13sp"
                            android:textColor="#222222"
                            android:buttonTint="@color/primary"
                            android:paddingStart="12dp"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Pay Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="48dp">

        <Button
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Pay ₹0"
            android:backgroundTint="@color/accent"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"/>
    </LinearLayout>

</LinearLayout>