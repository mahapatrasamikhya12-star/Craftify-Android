<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">

    <!-- Top Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="36dp"
        android:paddingBottom="10dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#1A1A1A"
            android:textSize="24sp"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/edit_text_border"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/etSearchMain"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Search handmade products..."
                android:textSize="13sp"
                android:textColorHint="#AAAAAA"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Search Results (hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutResults"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Result Count Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvSearchTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Results"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvResultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_gray"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="48dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="60sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No products found"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try searching for something else"
                android:textColor="@color/text_gray"
                android:textSize="13sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Results Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"/>

    </LinearLayout>

    <!-- Default Search Page (visible when no search) -->
    <ScrollView
        android:id="@+id/layoutDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Discount Banners -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:background="#E8F5E9"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="30%" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#2E7D32"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="OFF" android:textSize="12sp" android:textColor="#2E7D32"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:background="#EDE7F6"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="50%" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#6A1B9A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="OFF" android:textSize="12sp" android:textColor="#6A1B9A"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:background="#FFF3E0"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="70%" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#E65100"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="OFF" android:textSize="12sp" android:textColor="#E65100"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Categories Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop by Category"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingBottom="12dp"/>

            <!-- Categories Grid 4x2 -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="12dp">

                <!-- Jewellery -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:id="@+id/catJewellery">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:text="💍"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:background="#FFF3E0"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jewellery"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:textColor="#333333"/>

                </LinearLayout>

                <!-- Home Decor -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:id="@+id/catHomeDecor">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:text="🏡"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:background="#E8F5E9"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home Decor"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:textColor="#333333"/>
                </LinearLayout>

                <!-- Gift Items -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:id="@+id/catGifts">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:text="🎁"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:background="#FCE4EC"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gift Items"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:textColor="#333333"/>
                </LinearLayout>

                <!-- Frames -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:id="@+id/catFrames">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:text="🖼️"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:background="#E3F2FD"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frames"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:textColor="#333333"/>

                </LinearLayout>

                <!-- Portraits -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:id="@+id/catPortraits">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:text="🎨"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:background="#F3E5F5"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Portraits"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:textColor="#333333"/>
                </LinearLayout>

                <!-- Calendars -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:id="@+id/catCalendars">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:text="📅"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:background="#E0F7FA"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calendars"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:textColor="#333333"/>

                </LinearLayout>

                <!-- Cards -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:id="@+id/catCards">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:text="💌"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:background="#FFF3E0"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cards" android:textSize="11sp" android:gravity="center"
                        android:layout_marginTop="4dp" android:textColor="#333333"/>
                </LinearLayout>

                <!-- All Categories -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:id="@+id/catAll">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:text="🛍️"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:background="#EFEBE9"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Items"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:textColor="#333333"/>

                </LinearLayout>

            </GridLayout>

            <!-- Trending Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@color/primary"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Handcrafted with Love ❤️"
                        android:textColor="#FFECB3"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Authentic Crafts\nMade by Artisans"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧶"
                    android:textSize="50sp"/>
            </LinearLayout>

            <!-- Popular Searches -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Popular Searches"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp">

                <TextView android:id="@+id/tagDecor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home Decor"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/btn_add"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tagJewellery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jewellery"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/btn_add"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp"/>

                <TextView android:id="@+id/tagCards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cards"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/btn_add"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tagGifts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gifts"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/btn_add"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>