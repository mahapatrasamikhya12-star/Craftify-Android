<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D2B33">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Us"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Scroll Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/start_card_bg"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:text="📞"
                    android:textSize="48sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:text="Get in touch"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:text="We're here to help you 24/7"
                    android:textColor="#A8CDD4"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Email -->
            <LinearLayout
                android:id="@+id/btnEmail"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/start_card_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:clickable="true">

                <TextView
                    android:text="✉"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="Email Us"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>

                    <TextView
                        android:text="support@craftify.com"
                        android:textColor="#A8CDD4"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:id="@+id/btnPhone"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/start_card_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:clickable="true">

                <TextView
                    android:text="📞"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="Call Us"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>

                    <TextView
                        android:text="+91 98765 43210"
                        android:textColor="#A8CDD4"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- WhatsApp -->
            <LinearLayout
                android:id="@+id/btnWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/start_card_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:clickable="true">

                <TextView
                    android:text="💬"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="WhatsApp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>

                    <TextView
                        android:text="Chat with us instantly"
                        android:textColor="#A8CDD4"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/start_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="Send a message"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <EditText
                    android:id="@+id/etContactName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Your name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6A9FAA"
                    android:background="@drawable/search_bg_dark"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etContactEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Your email"
                    android:inputType="textEmailAddress"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6A9FAA"
                    android:background="@drawable/search_bg_dark"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etContactMessage"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Message"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6A9FAA"
                    android:background="@drawable/search_bg_dark"
                    android:gravity="top"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnSendMessage"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Send Message"
                    android:backgroundTint="#00BCD4"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>