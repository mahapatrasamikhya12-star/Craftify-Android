<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A6B7C"/>
        </shape>
    </item>

    <!-- Top right large blob -->
    <item
        android:top="-120dp"
        android:right="-80dp">
        <shape android:shape="oval">
            <solid android:color="#2D8FA3"/>
            <size android:width="280dp" android:height="280dp"/>
        </shape>
    </item>

    <!-- Middle left wave blob -->
    <item
        android:top="180dp"
        android:left="-100dp">
        <shape android:shape="oval">
            <solid android:color="#156070"/>
            <size android:width="300dp" android:height="260dp"/>
        </shape>
    </item>

    <!-- Bottom right blob -->
    <item
        android:bottom="-80dp"
        android:right="-60dp">
        <shape android:shape="oval">
            <solid android:color="#0D4A57"/>
            <size android:width="260dp" android:height="260dp"/>
        </shape>
    </item>

</layer-list>